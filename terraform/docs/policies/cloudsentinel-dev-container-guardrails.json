{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "NeverTouchProtectedProjects", "Effect": "Deny", "Action": ["ecr:*", "secretsmanager:*", "logs:*", "iam:*", "rds:*"], "Resource": ["arn:aws:ecr:*:229032674007:repository/cloudsentinel/p-11-*", "arn:aws:ecr:*:229032674007:repository/cloudsentinel/p-13-*", "arn:aws:ecr:*:229032674007:repository/cloudsentinel/p-17-*", "arn:aws:secretsmanager:*:229032674007:secret:cloudsentinel/p-11/*", "arn:aws:secretsmanager:*:229032674007:secret:cloudsentinel/p-13/*", "arn:aws:secretsmanager:*:229032674007:secret:cloudsentinel/p-17/*", "arn:aws:logs:*:229032674007:log-group:/cloudsentinel/projects/11/*", "arn:aws:logs:*:229032674007:log-group:/cloudsentinel/projects/13/*", "arn:aws:logs:*:229032674007:log-group:/cloudsentinel/projects/17/*", "arn:aws:iam::229032674007:role/cloudsentinel-p11-*", "arn:aws:iam::229032674007:role/cloudsentinel-p13-*", "arn:aws:iam::229032674007:role/cloudsentinel-p17-*", "arn:aws:rds:*:229032674007:db:cloudsentinel-p11-db", "arn:aws:rds:*:229032674007:db:cloudsentinel-p13-db", "arn:aws:rds:*:229032674007:db:cloudsentinel-p17-db", "arn:aws:rds:*:229032674007:subgrp:cloudsentinel-p11-db", "arn:aws:rds:*:229032674007:subgrp:cloudsentinel-p13-db", "arn:aws:rds:*:229032674007:subgrp:cloudsentinel-p17-db"]},
    {"Sid": "NoBoundaryRemovalNoManagedPolicies", "Effect": "Deny", "Action": ["iam:DeleteRolePermissionsBoundary", "iam:PutRolePermissionsBoundary", "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:CreatePolicy", "iam:CreatePolicyVersion", "iam:SetDefaultPolicyVersion", "iam:UpdateAssumeRolePolicy", "iam:PassRole"], "Resource": "*"},
    {"Sid": "OnlyApSouth1", "Effect": "Deny", "NotAction": ["iam:*", "sts:*"], "Resource": "*", "Condition": {"StringNotEquals": {"aws:RequestedRegion": "ap-south-1"}}}
