{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "ReadSharedClusterAndNetwork", "Effect": "Allow", "Action": ["eks:DescribeCluster"], "Resource": "arn:aws:eks:ap-south-1:229032674007:cluster/cloudsentinel-eks"},
    {"Sid": "ReadClusterOidcProvider", "Effect": "Allow", "Action": ["iam:GetOpenIDConnectProvider"], "Resource": "arn:aws:iam::229032674007:oidc-provider/oidc.eks.ap-south-1.amazonaws.com/id/*"},
    {"Sid": "Ec2DescribeHasNoResourceLevelPermissions", "Effect": "Allow", "Action": ["ec2:DescribeVpcs", "ec2:DescribeSubnets", "ec2:DescribeSecurityGroups", "ec2:DescribeSecurityGroupRules", "ec2:DescribeNetworkInterfaces", "ec2:DescribeVpcAttribute", "ec2:DescribeAccountAttributes"], "Resource": "*", "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-south-1"}}},
    {"Sid": "CreateTaggedDatabaseSecurityGroup", "Effect": "Allow", "Action": ["ec2:CreateSecurityGroup", "ec2:CreateTags"], "Resource": "arn:aws:ec2:ap-south-1:229032674007:security-group/*", "Condition": {"StringEquals": {"aws:RequestTag/Project": "cloudsentinel", "aws:RequestTag/Module": "8-eks-workload"}}},
    {"Sid": "CreateSecurityGroupInSharedVpcOnly", "Effect": "Allow", "Action": ["ec2:CreateSecurityGroup"], "Resource": "arn:aws:ec2:ap-south-1:229032674007:vpc/*", "Condition": {"StringEquals": {"aws:ResourceTag/cloudsentinel/role": "eks-shared-vpc"}}},
    {"Sid": "ManageOwnDatabaseSecurityGroups", "Effect": "Allow", "Action": ["ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress", "ec2:RevokeSecurityGroupEgress", "ec2:DeleteSecurityGroup", "ec2:CreateTags", "ec2:DeleteTags"], "Resource": "arn:aws:ec2:ap-south-1:229032674007:security-group/*", "Condition": {"StringEquals": {"aws:ResourceTag/Project": "cloudsentinel", "aws:ResourceTag/Module": "8-eks-workload"}}},
    {"Sid": "ProjectEcrRepositories", "Effect": "Allow", "Action": ["ecr:CreateRepository", "ecr:DeleteRepository", "ecr:DescribeRepositories", "ecr:ListTagsForResource", "ecr:TagResource", "ecr:UntagResource", "ecr:PutImageScanningConfiguration", "ecr:PutImageTagMutability", "ecr:GetLifecyclePolicy", "ecr:GetRepositoryPolicy", "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart", "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:DescribeImages", "ecr:DescribeImageScanFindings", "ecr:ListImages", "ecr:BatchDeleteImage"], "Resource": "arn:aws:ecr:ap-south-1:229032674007:repository/cloudsentinel/p-*"},
    {"Sid": "EcrLoginHasNoResourceLevelPermissions", "Effect": "Allow", "Action": ["ecr:GetAuthorizationToken"], "Resource": "*"},
    {"Sid": "ProjectSecretContainersNoRead", "Effect": "Allow", "Action": ["secretsmanager:CreateSecret", "secretsmanager:DeleteSecret", "secretsmanager:DescribeSecret", "secretsmanager:GetResourcePolicy", "secretsmanager:TagResource", "secretsmanager:UntagResource", "secretsmanager:UpdateSecret", "secretsmanager:PutSecretValue"], "Resource": "arn:aws:secretsmanager:ap-south-1:229032674007:secret:cloudsentinel/*"},
    {"Sid": "RdsManagedMasterPasswordSecret", "Effect": "Allow", "Action": ["secretsmanager:CreateSecret", "secretsmanager:TagResource", "secretsmanager:RotateSecret", "secretsmanager:DescribeSecret", "secretsmanager:DeleteSecret"], "Resource": "arn:aws:secretsmanager:ap-south-1:229032674007:secret:rds!*"},
    {"Sid": "ProjectLogGroups", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:DeleteLogGroup", "logs:PutRetentionPolicy", "logs:DeleteRetentionPolicy", "logs:TagResource", "logs:UntagResource", "logs:ListTagsForResource", "logs:TagLogGroup", "logs:ListTagsLogGroup"], "Resource": ["arn:aws:logs:ap-south-1:229032674007:log-group:/cloudsentinel/projects/*", "arn:aws:logs:ap-south-1:229032674007:log-group:/cloudsentinel/projects/*:*"]},
    {"Sid": "DescribeLogGroupsList", "Effect": "Allow", "Action": ["logs:DescribeLogGroups"], "Resource": "arn:aws:logs:ap-south-1:229032674007:log-group:*"},
    {"Sid": "ProjectIrsaRolesOnlyWithBoundary", "Effect": "Allow", "Action": ["iam:CreateRole", "iam:PutRolePolicy", "iam:DeleteRolePolicy"], "Resource": "arn:aws:iam::229032674007:role/cloudsentinel-p*-irsa", "Condition": {"StringEquals": {"iam:PermissionsBoundary": "arn:aws:iam::229032674007:policy/cloudsentinel-workload-boundary"}}},
    {"Sid": "ProjectIrsaRolesReadTagDelete", "Effect": "Allow", "Action": ["iam:GetRole", "iam:DeleteRole", "iam:TagRole", "iam:UntagRole", "iam:UpdateRoleDescription", "iam:ListRolePolicies", "iam:GetRolePolicy", "iam:ListAttachedRolePolicies", "iam:ListInstanceProfilesForRole"], "Resource": "arn:aws:iam::229032674007:role/cloudsentinel-p*-irsa"},
    {"Sid": "ProjectDatabases", "Effect": "Allow", "Action": ["rds:CreateDBInstance", "rds:DeleteDBInstance", "rds:DescribeDBInstances", "rds:ModifyDBInstance", "rds:AddTagsToResource", "rds:RemoveTagsFromResource", "rds:ListTagsForResource", "rds:CreateDBSubnetGroup", "rds:DeleteDBSubnetGroup", "rds:DescribeDBSubnetGroups", "rds:ModifyDBSubnetGroup"], "Resource": ["arn:aws:rds:ap-south-1:229032674007:db:cloudsentinel-p*-db", "arn:aws:rds:ap-south-1:229032674007:subgrp:cloudsentinel-p*-db", "arn:aws:rds:ap-south-1:229032674007:pg:default.*", "arn:aws:rds:ap-south-1:229032674007:og:default:*", "arn:aws:rds:ap-south-1:229032674007:secgrp:*"]},
    {"Sid": "RdsServiceLinkedRoleOnly", "Effect": "Allow", "Action": ["iam:CreateServiceLinkedRole"], "Resource": "arn:aws:iam::229032674007:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS", "Condition": {"StringEquals": {"iam:AWSServiceName": "rds.amazonaws.com"}}},
    {"Sid": "AwsManagedKeysViaRdsAndSecretsManager", "Effect": "Allow", "Action": ["kms:DescribeKey", "kms:Decrypt", "kms:GenerateDataKey"], "Resource": "arn:aws:kms:ap-south-1:229032674007:key/*", "Condition": {"StringEquals": {"kms:ViaService": ["rds.ap-south-1.amazonaws.com", "secretsmanager.ap-south-1.amazonaws.com"]}}},
    {"Sid": "GrantsOnlyForAwsResourcesViaRds", "Effect": "Allow", "Action": ["kms:CreateGrant"], "Resource": "arn:aws:kms:ap-south-1:229032674007:key/*", "Condition": {"StringEquals": {"kms:ViaService": "rds.ap-south-1.amazonaws.com"}, "Bool": {"kms:GrantIsForAWSResource": "true"}}}
  ]
}
