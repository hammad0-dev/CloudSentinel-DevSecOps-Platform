PORT=3000

CLONE_DIR=/tmp/cloudsentinel-scans

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudsentinel
DB_USER=csuser
DB_PASSWORD=your_password

# Security
JWT_SECRET=your_jwt_secret

# Trivy & External integrations
TRIVY_CMD=trivy
# Image-scan vulnerability DB (Deploy stage). The backend warms it at start and every TRIVY_DB_WARM_INTERVAL_HOURS
# (trivy image --download-db-only), and the scan skips the DB update only while the DB is younger than
# TRIVY_DB_MAX_AGE_HOURS. An older or missing DB is updated during the scan as before.
# TRIVY_DB_WARM=on
# TRIVY_DB_WARM_INTERVAL_HOURS=6
# TRIVY_DB_MAX_AGE_HOURS=48
# IMAGE_TRIVY_CACHE_DIR=            (default: Trivy's own cache; snap Trivy needs a path under ~/snap/trivy/common)
GITHUB_TOKEN=your_github_token
FRONTEND_URL=http://localhost:5173

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=CloudSentinel <your_email@gmail.com>

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Module 11 monitoring
LOKI_URL=http://localhost:3100
# Optional: push backend events straight to Loki (instead of a Promtail file tail). Base URL or the full
# .../loki/api/v1/push URL both work. Leave it unset (or set it to "off") when no Loki is reachable: the local
# Minikube stack does not expose Loki on localhost, and port 3100 is often used by a temporary second backend.
# If the endpoint is down, pushing pauses after 3 consecutive failures (back-off 1 min doubling to 30 min, one
# loki_push_paused warning per pause) and resumes after the first successful push. Logs always go to stdout/APP_LOG_FILE.
# LOKI_PUSH_URL=http://localhost:3100
MONITORING_ADMIN_EMAILS=
METRICS_TOKEN=
K8S_SIGNALS=on
# APP_LOG_FILE=/var/log/cloudsentinel/app.log

# Scan engines (docs/ml-architecture.md). Default: the trained ML services for both SAST and DAST.
# If an ML service is unreachable or returns an error, the stage fails; there is no fallback.
# SAST_ENGINE: ml (default) | sonar (legacy, benchmark only)
# DAST_ENGINE: ml (default) | zap   (legacy, benchmark only)
SAST_ENGINE=ml
DAST_ENGINE=ml
ML_SAST_URL=http://127.0.0.1:8001
ML_DAST_URL=http://127.0.0.1:8002
# ml-sast v3 runs CodeBERT on CPU (about 0.14-0.26 s per function); 1800000 ms matches the orchestrator.
# ML_SAST_TIMEOUT_MS=1800000
# ML_DAST_TIMEOUT_MS=1800000
# ML_SAST_MAX_FILES=5000
# ML_SAST_MAX_FILE_BYTES=524288
# ML_SAST_MAX_TOTAL_BYTES=20971520
# ML_DAST_MAX_PAGES=50
# ML_DAST_MAX_REQUESTS=500
# Plumbing tests only: let an untrained model complete a scan (always zero findings).
ML_ALLOW_UNTRAINED=false

# Legacy, benchmark only: needed ONLY with SAST_ENGINE=sonar (SonarQube server + sonar-scanner).
# SONAR_HOST=http://localhost:9000
# SONAR_TOKEN=your_sonarqube_token
# SONAR_SCANNER_PATH=/path/to/sonar-scanner
# Required when SONAR_HOST points to SonarQube Cloud; use the organization key.
# SONAR_ORGANIZATION=your-organization-key
# Legacy, benchmark only: DAST_ENGINE=zap runs the ZAP baseline Docker image (ZAP_IMAGE).
