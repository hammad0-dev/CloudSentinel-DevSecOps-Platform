PORT=3000

# SonarQube
SONAR_HOST=http://localhost:9000
# Required when SONAR_HOST points to SonarQube Cloud; use the organization key.
# SONAR_ORGANIZATION=your-organization-key
SONAR_TOKEN=your_sonarqube_token
SONAR_SCANNER_PATH=/path/to/sonar-scanner
CLONE_DIR=/tmp/cloudsentinel-scans

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudsentinel
DB_USER=csuser
DB_PASSWORD=your_password

# Security
JWT_SECRET=your_jwt_secret

# Trivy & External integrations
TRIVY_CMD=trivy
GITHUB_TOKEN=your_github_token
FRONTEND_URL=http://localhost:5173

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=CloudSentinel <your_email@gmail.com>

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
