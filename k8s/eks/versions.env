# Pinned Helm charts for the shared EKS cluster (Kubernetes 1.36). Checked 2026-11-25; see docs/eks-progress.md.
# Sourced by the Stage 4-6 install scripts: helm install ... --version "$KYVERNO_CHART" etc.

# Kyverno 1.19 supports Kubernetes 1.33-1.35 only; 1.20 supports 1.34-1.37 (kyverno.io releases page).
# v1.20.0 was published 2026-11-12 (13 days before pinning): the only Kyverno release that supports 1.36.
KYVERNO_CHART=3.10.0            # app v1.20.0
# ESO 2.14 is tested up to Kubernetes 1.37 (external-secrets.io stability-support table). Same as Stage 2.
ESO_CHART=2.14.0                # app v2.14.0, 2026-10-23
# 93.1.2 bundles kube-state-metrics 2.20 (client-go 1.36) and prometheus-operator v0.95.2.
KPS_CHART=93.1.2                # 2026-11-10
# Logs: Promtail is deprecated (chart marked deprecated); Grafana Alloy ships logs to Loki.
LOKI_CHART=7.5.0                # app 3.6.16, 2026-10-22
ALLOY_CHART=1.14.4              # app v1.21.3, 2026-10-28
# Falco (optional, last stage): modern eBPF driver; no Kubernetes version constraint (kernel-based).
FALCO_CHART=9.2.2               # app 0.45.2, 2026-10-29
# metrics-server is the EKS add-on v0.9.1-eksbuild.2 (terraform/environments/aws-demo/main.tf), not a chart.
